# --- Dexra ---
# dxr_... key from https://dexra.dev/app/keys. Without it, paid checks answer 402 and every buy is blocked.
DEXRA_API_KEY=
# Point at a local API for testing, e.g. http://127.0.0.1:3000
DEXRA_BASE_URL=https://api.dexra.dev

# --- Trading (read by dexra_core) ---
# Live trading needs DRY_RUN=false AND SOLANA_PRIVATE_KEY AND JUPITER_API_KEY. Anything missing keeps a dry run.
DRY_RUN=true
# Sent as x-api-key to Jupiter. Needed for live trading; in a dry run it adds a quote.
JUPITER_API_KEY=
# Base58 64-byte secret key. Only for live trading. Use a dedicated wallet that holds little SOL.
SOLANA_PRIVATE_KEY=
# Hard cap per buy, in SOL. A larger buy is refused, not reduced.
MAX_TRADE_SOL=0.05
# Jupiter slippage, whole number from 0 to 1000.
SLIPPAGE_BPS=100
# When true, a "caution" verdict passes. "avoid" and "unknown" always block.
ALLOW_CAUTION=false

# --- Agent ---
# SOL per buy in graph mode when --amount is not given.
BUY_AMOUNT_SOL=0.01
# Ask a human before every live buy (graph) or live buy/sell (chat). Dry runs never ask.
REQUIRE_APPROVAL=true

# --- LLM (chat mode only; graph mode needs no LLM) ---
# anthropic or openai
LLM_PROVIDER=anthropic
# Default: claude-sonnet-5-5 for anthropic, gpt-5.6-luna for openai
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Dexra remote MCP (chat mode, optional) ---
# Adds Dexra's read-only MCP tools to the chat agent. buy and sell stay on the local guard.
USE_DEXRA_MCP=false
# Default: $DEXRA_BASE_URL/mcp
DEXRA_MCP_URL=
